# NUMU Moodle Environment Variables
# Copy this file to .env and update values

# Database Configuration
POSTGRES_DB=moodle_numu
POSTGRES_USER=moodle_user
POSTGRES_PASSWORD=numu_secure_2026

# Redis Configuration
REDIS_PASSWORD=numu_redis_2026

# Moodle Configuration
MOODLE_WWWROOT=http://localhost:8080
MOODLE_ADMIN_EMAIL=admin@numu.com
MOODLE_ADMIN_PASSWORD=Admin@NUMU2026!

# NUMU Integration
NUMU_API_ENDPOINT=http://localhost:3000/api/moodle
NUMU_API_KEY=numu_integration_key_2026
NUMU_WEBHOOK_SECRET=numu_webhook_secret_2026

# Security
MOODLE_CRON_PASSWORD=numu_cron_secret_2026

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@numu.com
SMTP_PASSWORD=your-smtp-password
SMTP_SECURE=tls

# Timezone
TZ=America/Argentina/Buenos_Aires
