# ==============================================================
# NUMU Security Platform - Environment Variables Template
# ==============================================================
# Copy this file to .env or .env.local and fill in the values.

# --------------------------------------------------------------
# 1. Database (PostgreSQL via Prisma)
# --------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/numu_csirt?schema=public"

# --------------------------------------------------------------
# 2. NextAuth & Security
# --------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3100"
NEXTAUTH_SECRET="generate-a-secure-random-secret-here"
JWT_SECRET="generate-a-secure-random-secret-here"

# --------------------------------------------------------------
# 3. AI Agent (Python Microservice / External LLMs)
# --------------------------------------------------------------
AI_AGENT_URL="http://localhost:8000"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# --------------------------------------------------------------
# 4. Backend Workers & Services
# --------------------------------------------------------------
NEXT_PUBLIC_BACKEND_URL="http://localhost:4000"
NEXT_PUBLIC_URL="http://localhost:3100"
CSIRT_API_KEY=""

# --------------------------------------------------------------
# 5. Threat Intelligence APIs (Optional)
# --------------------------------------------------------------
SHODAN_API_KEY=""
VIRUSTOTAL_API_KEY=""
ABUSEIPDB_API_KEY=""
FOFA_API_KEY=""

# --------------------------------------------------------------
# 6. Moodle LMS Integration
# --------------------------------------------------------------
MOODLE_URL="http://localhost:8080"
MOODLE_WS_TOKEN=""
