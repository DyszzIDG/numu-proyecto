// ============================================
// CSIRT SYSTEM - MVP PHASE 1
// ============================================

// Core CSIRT User model extension (uses existing User model)
model CSIRTUser {
  id         String    @id @default(cuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       CSIRTRole @default(ANALYST)
  department String?
  phone      String?
  isActive   Boolean   @default(true)
  lastLogin  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  scans              CSIRTScan[]
  csirtIncidents     CSIRTIncident[]
  threats            ThreatIntelligence[]
  csirtComments      CSIRTComment[]
  csirtNotifications CSIRTNotification[]
  csirtAuditLogs     CSIRTAuditLog[]

  @@index([userId])
  @@index([role])
}

enum CSIRTRole {
  ADMIN
  MANAGER
  ANALYST
  VIEWER
  AUDITOR
}

// ===== MÓDULO ESCANEO =====
model CSIRTScan {
  id          String          @id @default(cuid())
  name        String
  description String?         @db.Text
  target      String // IP, domain, URL
  type        CSIRTScanType
  status      CSIRTScanStatus @default(QUEUED)
  mode        CSIRTScanMode   @default(MANUAL)
  progress    Int             @default(0)
  priority    CSIRTPriority   @default(MEDIUM)

  // Configuración de herramientas
  tools           String[] // ["nmap", "nuclei", "zap"]
  nmapOptions     Json? // {flags: "-sV -sC", ports: "1-1000"}
  nucleiTemplates String[]
  zapProfile      String?
  customCommands  Json?

  // Opciones avanzadas
  stealthMode Boolean @default(false)
  threads     Int     @default(10)
  timeout     Int     @default(300)
  retries     Int     @default(3)
  userAgent   String?
  proxy       String?

  // Programación
  scheduled   Boolean   @default(false)
  scheduledAt DateTime?
  recurrence  String? // cron expression

  // Resultados
  startedAt   DateTime?
  completedAt DateTime?
  duration    Int? // segundos
  rawOutput   String?   @db.Text
  errorLog    String?   @db.Text

  // Relaciones
  userId String
  user   CSIRTUser @relation(fields: [userId], references: [id])

  vulnerabilities CSIRTVulnerability[]
  ports           CSIRTPort[]
  services        CSIRTService[]
  screenshots     CSIRTScreenshot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([target])
  @@index([type])
}

enum CSIRTScanType {
  NETWORK
  WEB_APPLICATION
  API
  CLOUD
  MOBILE
  INFRASTRUCTURE
  FULL_STACK
}

enum CSIRTScanStatus {
  QUEUED
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

enum CSIRTScanMode {
  MANUAL
  AI_ASSISTED
  AUTOMATED
}

enum CSIRTPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model CSIRTVulnerability {
  id          String        @id @default(cuid())
  title       String
  description String        @db.Text
  severity    CSIRTSeverity
  cvss        Float?
  cve         String?
  cwe         String?
  owasp       String?

  // Detalles técnicos
  affectedUrl   String?
  affectedParam String?
  payload       String? @db.Text
  evidence      String? @db.Text
  reproduction  String? @db.Text

  // Remediación
  remediation     String?  @db.Text
  references      String[]
  estimatedEffort String?

  // Estado
  status        CSIRTVulnStatus @default(OPEN)
  falsePositive Boolean         @default(false)
  risk          String?

  // Relaciones
  scanId String
  scan   CSIRTScan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  incidentId String?
  incident   CSIRTIncident? @relation(fields: [incidentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([severity, status])
  @@index([cve])
  @@index([scanId])
}

enum CSIRTSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CSIRTVulnStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  WONT_FIX
  FALSE_POSITIVE
}

model CSIRTPort {
  id       String  @id @default(cuid())
  number   Int
  protocol String // TCP, UDP
  state    String // open, closed, filtered
  service  String?
  version  String?

  scanId String
  scan   CSIRTScan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([scanId])
}

model CSIRTService {
  id       String  @id @default(cuid())
  name     String
  version  String?
  product  String?
  port     Int?
  protocol String?
  banner   String? @db.Text

  scanId String
  scan   CSIRTScan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([scanId])
}

model CSIRTScreenshot {
  id          String  @id @default(cuid())
  url         String
  path        String // ruta en servidor
  description String?

  scanId String
  scan   CSIRTScan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([scanId])
}

// ===== MÓDULO GESTIÓN DE INCIDENTES =====
model CSIRTIncident {
  id          String              @id @default(cuid())
  title       String
  description String              @db.Text
  type        CSIRTIncidentType
  severity    CSIRTSeverity
  status      CSIRTIncidentStatus @default(NEW)
  priority    CSIRTPriority       @default(MEDIUM)

  // Clasificación
  category       String
  subcategory    String?
  source         String // IDS, User Report, Scan, etc
  affectedAssets String[]

  // Timeline
  detectedAt     DateTime
  reportedAt     DateTime  @default(now())
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  closedAt       DateTime?

  // Análisis
  rootCause      String? @db.Text
  impact         String? @db.Text
  actionsTaken   String? @db.Text
  lessonsLearned String? @db.Text

  // Asignación
  assignedTo   String?
  assignedUser CSIRTUser? @relation(fields: [assignedTo], references: [id])

  // Relaciones
  vulnerabilities CSIRTVulnerability[]
  evidences       CSIRTEvidence[]
  timeline        CSIRTIncidentTimeline[]
  comments        CSIRTComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, severity])
  @@index([assignedTo])
  @@index([type])
}

enum CSIRTIncidentType {
  MALWARE
  PHISHING
  DATA_BREACH
  DOS_DDOS
  UNAUTHORIZED_ACCESS
  POLICY_VIOLATION
  RANSOMWARE
  APT
  INSIDER_THREAT
  OTHER
}

enum CSIRTIncidentStatus {
  NEW
  ACKNOWLEDGED
  INVESTIGATING
  CONTAINED
  RESOLVED
  CLOSED
  FALSE_ALARM
}

model CSIRTEvidence {
  id          String  @id @default(cuid())
  type        String // file, log, screenshot, network_capture
  name        String
  path        String
  hash        String?
  size        Int?
  mimeType    String?
  description String? @db.Text

  incidentId String
  incident   CSIRTIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([incidentId])
}

model CSIRTIncidentTimeline {
  id          String   @id @default(cuid())
  timestamp   DateTime @default(now())
  action      String
  description String   @db.Text
  user        String

  incidentId String
  incident   CSIRTIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
  @@index([timestamp])
}

// ===== MÓDULO THREAT INTELLIGENCE =====
model ThreatIntelligence {
  id          String        @id @default(cuid())
  title       String
  description String        @db.Text
  type        ThreatType
  severity    CSIRTSeverity

  // Indicadores
  iocs       ThreatIOC[]
  ttps       String[] // MITRE ATT&CK tactics
  techniques String[] // MITRE ATT&CK techniques

  // Fuentes
  source     String
  sourceUrl  String?
  confidence Int // 0-100

  // Análisis
  targetedSectors String[]
  affectedRegions String[]
  campaignName    String?
  threatActor     String?

  // Estado
  status   String  @default("ACTIVE")
  isPublic Boolean @default(false)

  userId String
  user   CSIRTUser @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, severity])
  @@index([userId])
}

enum ThreatType {
  MALWARE
  PHISHING
  RANSOMWARE
  APT
  VULNERABILITY
  EXPLOIT
  BOTNET
  C2_SERVER
  SUSPICIOUS_DOMAIN
  DATA_LEAK
}

model ThreatIOC {
  id          String   @id @default(cuid())
  type        IOCType
  value       String
  description String?
  firstSeen   DateTime @default(now())
  lastSeen    DateTime @default(now())

  threatId String
  threat   ThreatIntelligence @relation(fields: [threatId], references: [id], onDelete: Cascade)

  @@index([type, value])
  @@index([threatId])
}

enum IOCType {
  IP_ADDRESS
  DOMAIN
  URL
  FILE_HASH_MD5
  FILE_HASH_SHA1
  FILE_HASH_SHA256
  EMAIL
  MUTEX
  REGISTRY_KEY
  USER_AGENT
  CERTIFICATE
}

// ===== TABLAS COMUNES =====
model CSIRTComment {
  id         String @id @default(cuid())
  content    String @db.Text
  entityType String // incident, scan, threat, etc
  entityId   String

  userId String
  user   CSIRTUser @relation(fields: [userId], references: [id])

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  CSIRTIncident   CSIRTIncident? @relation(fields: [cSIRTIncidentId], references: [id])
  cSIRTIncidentId String?

  @@index([entityType, entityId])
  @@index([userId])
}

model CSIRTNotification {
  id      String  @id @default(cuid())
  type    String
  title   String
  message String  @db.Text
  isRead  Boolean @default(false)
  link    String?

  userId String
  user   CSIRTUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model CSIRTAuditLog {
  id         String  @id @default(cuid())
  action     String
  entityType String
  entityId   String?
  changes    Json?
  ipAddress  String?
  userAgent  String?

  userId String
  user   CSIRTUser @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([entityType, entityId])
}

model CSIRTSystemConfig {
  id          String  @id @default(cuid())
  key         String  @unique
  value       Json
  description String?
  category    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

// ============================================
// FORENSICS MODULE
// ============================================

model ForensicEvidence {
  id            String   @id @default(cuid())
  caseId        String?
  case          Case?    @relation(fields: [caseId], references: [id])
  
  description   String
  type          String   // "disk_image", "memory_dump", "log_file", "network_pcap", "physical_device"
  status        String   // "acquired", "analyzing", "archived", "disposed"
  
  // Chain of Custody
  acquiredBy    String
  acquiredAt    DateTime @default(now())
  custodian     String   // Current holder
  location      String   // Physical or digital location
  
  // Technical Details
  hashAlgorithm String?  // "SHA256", "MD5"
  hashValue     String?
  sizeBytes     BigInt?
  
  metadata      String?  @db.Text // JSON with specific details (serial number, make, model)
  notes         String?  @db.Text
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([caseId])
  @@index([type])
  @@index([status])
}

// ============================================
// MOODLE INTEGRATION
// ============================================

model MoodleAccount {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Moodle credentials
  moodleUserId  Int      @unique
  moodleUsername String  @unique
  moodleEmail   String
  
  // Linking status
  isLinked      Boolean  @default(false)
  isVerified    Boolean  @default(false)
  linkToken     String?  @unique // For verification
  linkTokenExpiry DateTime?
  
  // Sync data
  lastSyncAt    DateTime?
  syncStatus    String   @default("pending") // pending, synced, error
  syncError     String?  @db.Text
  
  // Moodle data cache (JSON)
  enrollments   String?  @db.Text // JSON array of course enrollments
  completions   String?  @db.Text // JSON array of completed courses
  certificates  String?  @db.Text // JSON array of certificates
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([userId])
  @@index([moodleUserId])
  @@index([isLinked])
}

model MoodleCourse {
  id              String   @id @default(cuid())
  moodleCourseId  Int      @unique
  
  // Course details
  fullname        String
  shortname       String
  category        String?
  summary         String?  @db.Text
  
  // Metadata
  startDate       DateTime?
  endDate         DateTime?
  visible         Boolean  @default(true)
  format          String?  // topics, weeks, social
  
  // NUMU categorization
  serviceType     ServiceType @default(EDUCATION)
  difficulty      String?  // beginner, intermediate, advanced
  estimatedHours  Int?
  
  // Tracking
  enrollments     MoodleEnrollment[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([moodleCourseId])
  @@index([serviceType])
  @@index([visible])
}

model MoodleEnrollment {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId        String
  course          MoodleCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  
  // Enrollment details
  enrolledAt      DateTime @default(now())
  status          String   @default("active") // active, suspended, completed
  role            String   @default("student") // student, teacher, manager
  
  // Progress tracking
  progress        Int      @default(0) // 0-100
  lastAccessed    DateTime?
  completedAt     DateTime?
  grade           Float?
  
  // Sync
  moodleEnrollmentId Int?
  lastSyncAt      DateTime?
  
  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@index([status])
}
