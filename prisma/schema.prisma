// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id              String            @id @default(cuid())
  name            String?
  email           String?           @unique
  emailVerified   DateTime?
  password        String?
  image           String?
  role            String            @default("USER") // ADMIN, USER
  isAdmin         Boolean           @default(false)
  isSuperAdmin    Boolean           @default(false) // Full control over all dashboards
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  accounts        Account[]
  sessions        Session[]
  plan            UserPlan?
  toolExecutions  ToolExecution[]
  dashboardAccess DashboardAccess[]
  ctfSolves       CTFSolve[]
  transactions    Transaction[]
  userProfile     UserProfile?
  enrollments     Enrollment[]
  lessonProgress  LessonProgress[]
  // Advanced features
  scanTags        ScanTag[]
  scanAnnotations ScanAnnotation[]
  workflows       Workflow[]
  shareLinks      ShareLink[]
  scanJobs        ScanJob[]
  // CSIRT Profile
  csirtProfile    CSIRTUser?
  // Moodle Integration
  moodleAccount   MoodleAccount?
  moodleEnrollments MoodleEnrollment[]
}

enum ServiceType {
  CYBERSECURITY
  EDUCATION
  AI
  FINTECH
  GENERAL
}

model UserProfile {
  id              String           @id @default(cuid())
  userId          String           @unique
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio             String?          @db.Text
  location        String?
  website         String?
  github          String?
  linkedin        String?
  twitter         String?
  serviceProfiles ServiceProfile[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model ServiceProfile {
  id            String      @id @default(cuid())
  userProfileId String
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  service       ServiceType

  // Service specific fields (stored as JSON for flexibility across services)
  metadata String? @db.Text // JSON string: { "level": "expert", "certifications": [], "interests": [] }
  stats    String? @db.Text // JSON string: { "courses_completed": 10, "ctf_score": 500 }
  settings String? @db.Text // JSON string: { "theme": "dark", "notifications": true }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userProfileId, service])
  @@index([userProfileId])
  @@index([service])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model CSIRTCategory {
  id          String      @id @default(cuid())
  name        String      @unique
  description String      @db.Text
  icon        String // Nombre del icono de lucide-react
  color       String // Color temático (cyan, green, magenta, etc.)
  order       Int         @default(0)
  tools       CSIRTTool[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model CSIRTTool {
  id          String        @id @default(cuid())
  name        String
  description String        @db.Text
  url         String? // URL de la herramienta
  category    CSIRTCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId  String
  tags        String        @db.Text // JSON array de tags
  isPaid      Boolean       @default(false)
  platform    String? // Windows, Linux, macOS, Web, etc.
  featured    Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([categoryId])
  @@index([featured])
}

model ScanTarget {
  id             String          @id @default(cuid())
  target         String          @unique // Domain or IP address
  type           String // "domain" or "ip"
  description    String?         @db.Text
  scans          ScanResult[]
  scheduledScans ScheduledScan[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model ScanResult {
  id          String           @id @default(cuid())
  target      ScanTarget       @relation(fields: [targetId], references: [id], onDelete: Cascade)
  targetId    String
  scanType    String // "nmap", "dns", "ssl", "http", "whois", "full"
  status      String // "success", "failed", "partial"
  startedAt   DateTime
  completedAt DateTime?
  duration    Int? // Duration in seconds
  metadata    String?          @db.Text // JSON with additional data
  findings    ScanFinding[]
  cases       Case[]
  // Advanced features
  tags        ScanTag[]
  annotations ScanAnnotation[]
  shareLinks  ShareLink[]
  comments    Comment[]
  createdAt   DateTime         @default(now())

  @@index([targetId])
  @@index([scanType])
  @@index([startedAt])
}

model ScanFinding {
  id          String     @id @default(cuid())
  scan        ScanResult @relation(fields: [scanId], references: [id], onDelete: Cascade)
  scanId      String
  category    String // "port", "dns", "ssl", "header", "vulnerability"
  severity    String // "info", "low", "medium", "high", "critical"
  title       String
  description String     @db.Text
  rawData     String?    @db.Text // Original output
  comments    Comment[]
  createdAt   DateTime   @default(now())

  @@index([scanId])
  @@index([severity])
}

// ============================================
// COMPANY SECURITY ASSESSMENT SYSTEM
// ============================================

model Company {
  id              String          @id @default(cuid())
  name            String
  industry        String
  size            String // "1-10", "11-50", "51-200", "201-500", "500+"
  country         String
  contactEmail    String          @unique
  contactName     String
  contactPhone    String?
  website         String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  assessments     Assessment[]
  cases           Case[]
  client          Client?
  certifications  Certification[]
  referrals       Referral[]
  industryId      String?
  industryDetails Industry?       @relation(fields: [industryId], references: [id])

  @@index([contactEmail])
  @@index([industry])
  @@index([industryId])
}

model Client {
  id           String    @id @default(cuid())
  companyId    String    @unique
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email        String    @unique
  passwordHash String
  isActive     Boolean   @default(true)
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([email])
  @@index([companyId])
}

model AssessmentCategory {
  id                 String             @id @default(cuid())
  name               String             @unique
  description        String             @db.Text
  weight             Int // Percentage weight in overall score
  icon               String
  color              String
  order              Int
  questions          Question[]
  industryCategories IndustryCategory[]
  createdAt          DateTime           @default(now())

  @@index([order])
}

model Question {
  id          String             @id @default(cuid())
  category    AssessmentCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId  String
  text        String             @db.Text
  description String?            @db.Text
  type        String // "yes_no", "multiple_choice", "scale"
  options     String?            @db.Text // JSON array for multiple choice
  weight      Int // Points for this question
  order       Int
  answers     AssessmentAnswer[]
  createdAt   DateTime           @default(now())

  @@index([categoryId])
  @@index([order])
}

model Assessment {
  id              String             @id @default(cuid())
  company         Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId       String
  status          String // "in_progress", "completed"
  type            String? // "security_maturity", etc.
  score           Int? // 0-100
  maturityLevel   String? // "initial", "developing", "defined", "managed", "optimized"
  categoryScores  String?            @db.Text // JSON with scores per category
  recommendations String?            @db.Text // JSON with recommendations
  startedAt       DateTime           @default(now())
  completedAt     DateTime?
  answers         AssessmentAnswer[]
  cases           Case[]
  certifications  Certification[]

  @@index([companyId])
  @@index([status])
  @@index([score])
}

model AssessmentAnswer {
  id           String     @id @default(cuid())
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  assessmentId String
  question     Question   @relation(fields: [questionId], references: [id])
  questionId   String
  value        String // Answer value (converted to string to solve DB conflict)
  points       Int? // Points earned
  createdAt    DateTime   @default(now())

  @@index([assessmentId])
  @@index([questionId])
  @@map("Answer") // Keep optional mapping if table exists, or remove if new. Assuming new or safe to migrate.
}

// ============================================
// EMPLOYEE PORTAL & CASE MANAGEMENT
// ============================================

model Employee {
  id                String           @id @default(cuid())
  email             String           @unique
  password          String // Hashed with bcrypt
  firstName         String
  lastName          String
  role              String // "admin", "hr", "analyst", "viewer"
  department        Department?      @relation(fields: [departmentId], references: [id])
  departmentId      String?
  isActive          Boolean          @default(true)
  avatar            String?
  phone             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  assignedCases     CaseAssignment[]
  caseComments      CaseComment[]
  toolExecutions    ToolExecution[]
  wikiArticles      WikiArticle[]
  notifications     Notification[]
  shifts            Shift[]
  assignedIncidents Incident[]

  @@index([email])
  @@index([role])
  @@index([departmentId])
}

model Department {
  id          String     @id @default(cuid())
  name        String     @unique // "RRHH", "Seguridad", "Análisis", etc.
  description String?    @db.Text
  employees   Employee[]
  cases       Case[]
  createdAt   DateTime   @default(now())
}

model Case {
  id          String @id @default(cuid())
  title       String
  description String @db.Text
  priority    String // "low", "medium", "high", "critical"
  status      String // "open", "in_progress", "resolved", "closed"
  type        String // "assessment_followup", "scan_issue", "security_incident", "general"

  // Links to existing data
  company      Company?    @relation(fields: [companyId], references: [id])
  companyId    String?
  assessment   Assessment? @relation(fields: [assessmentId], references: [id])
  assessmentId String?
  scanResult   ScanResult? @relation(fields: [scanResultId], references: [id])
  scanResultId String?

  // Department assignment
  department   Department? @relation(fields: [departmentId], references: [id])
  departmentId String?

  // Tracking
  assignments CaseAssignment[]
  comments    CaseComment[]
  attachments CaseAttachment[]
  evidence    ForensicEvidence[] // Relation to forensics module
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  resolvedAt  DateTime?

  @@index([companyId])
  @@index([status])
  @@index([priority])
  @@index([departmentId])
  @@index([type])
}

model CaseAssignment {
  id         String   @id @default(cuid())
  case       Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId     String
  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId String
  assignedAt DateTime @default(now())
  isActive   Boolean  @default(true)

  @@index([caseId])
  @@index([employeeId])
}

model CaseComment {
  id         String   @id @default(cuid())
  case       Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  caseId     String
  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId String
  comment    String   @db.Text
  createdAt  DateTime @default(now())

  @@index([caseId])
  @@index([employeeId])
}

// ============================================
// CERTIFICATION PROGRAM
// ============================================

model CertificationTier {
  id             String          @id @default(cuid())
  name           String          @unique // "Bronze", "Silver", "Gold", "Platinum"
  slug           String          @unique // "bronze", "silver", "gold", "platinum"
  minScore       Int // 50, 70, 85, 95
  maxScore       Int // 69, 84, 94, 100
  price          Int // $299, $499, $799, $999 (in cents: 29900, 49900, 79900, 99900)
  color          String // Hex color
  icon           String // Emoji or icon name
  benefits       String          @db.Text // JSON array of benefits
  description    String          @db.Text
  order          Int // Display order
  isActive       Boolean         @default(true)
  certifications Certification[]
  createdAt      DateTime        @default(now())

  @@index([order])
  @@index([slug])
}

model Certification {
  id           String            @id @default(cuid())
  companyId    String
  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tierId       String
  tier         CertificationTier @relation(fields: [tierId], references: [id])
  assessmentId String
  assessment   Assessment        @relation(fields: [assessmentId], references: [id])

  // Certificate details
  certificateNumber String  @unique // NUMU-2025-XXXXX
  score             Int // Score at certification time
  certificateUrl    String? // S3 URL to PDF
  badgeCode         String? @db.Text // HTML embed code
  qrCodeUrl         String? // QR code for verification

  // Status
  status   String  @default("pending") // pending, active, expired, revoked
  isPublic Boolean @default(false) // Show in directory

  // Dates
  issuedAt      DateTime?
  expiresAt     DateTime? // 12 months from issuedAt
  revokedAt     DateTime?
  revokedReason String?   @db.Text

  // Notifications
  reminderSent30d Boolean @default(false)
  reminderSent7d  Boolean @default(false)

  // Payment
  payment CertificationPayment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([certificateNumber])
  @@index([tierId])
}

model CertificationPayment {
  id              String        @id @default(cuid())
  certificationId String        @unique
  certification   Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)

  // Stripe details
  stripePaymentId  String? @unique
  stripeCustomerId String?
  stripeSessionId  String? @unique
  amount           Int // Amount in cents
  currency         String  @default("USD")
  status           String // pending, succeeded, failed, refunded

  // Payment metadata
  paymentMethod String? // card, bank_transfer, etc.
  receiptUrl    String?
  invoiceUrl    String?

  paidAt     DateTime?
  refundedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([certificationId])
  @@index([status])
  @@index([stripeSessionId])
}

// ============================================
// AFFILIATE PROGRAM
// ============================================

model Affiliate {
  id             String  @id @default(cuid())
  userId         String? // Optional link to user account
  email          String  @unique
  name           String
  code           String  @unique // Unique referral code (e.g., "IVAN2025")
  commissionRate Int     @default(20) // 20%

  // Payment info
  paymentEmail  String // PayPal/Stripe email
  paymentMethod String  @default("paypal") // "paypal", "stripe", "bank"
  bankInfo      String? @db.Text // JSON with bank details (encrypted)

  // Status
  status     String  @default("pending") // "pending", "active", "suspended", "inactive"
  isVerified Boolean @default(false)

  // Stats
  totalClicks     Int @default(0)
  totalReferrals  Int @default(0)
  totalEarnings   Int @default(0) // In cents
  pendingEarnings Int @default(0) // In cents

  // Relations
  referrals Referral[]
  payouts   AffiliatePayout[]
  clicks    AffiliateClick[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@index([email])
  @@index([status])
}

model Referral {
  id          String    @id @default(cuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  // Referred company
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  // Status tracking
  status String @default("pending") // "pending", "converted", "active", "cancelled"

  // Financial
  subscriptionTier String? // "free", "pro", "enterprise"
  monthlyRevenue   Int     @default(0) // In cents
  totalRevenue     Int     @default(0) // In cents
  commission       Int     @default(0) // Total commission earned (in cents)
  commissionPaid   Int     @default(0) // Commission already paid (in cents)

  // Dates
  createdAt      DateTime  @default(now()) // When referral link was clicked
  convertedAt    DateTime? // When company signed up
  firstPaymentAt DateTime? // When company made first payment
  expiresAt      DateTime? // 12 months after first payment
  cancelledAt    DateTime?

  @@index([affiliateId])
  @@index([companyId])
  @@index([status])
}

model AffiliateClick {
  id          String    @id @default(cuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  // Tracking
  ipAddress String?
  userAgent String? @db.Text
  referer   String? @db.Text
  country   String?

  // Conversion
  converted Boolean @default(false)
  companyId String?

  clickedAt DateTime @default(now())

  @@index([affiliateId])
  @@index([clickedAt])
}

model AffiliatePayout {
  id          String    @id @default(cuid())
  affiliateId String
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  // Amount
  amount   Int // In cents
  currency String @default("USD")

  // Payment details
  method        String // "paypal", "stripe", "bank_transfer"
  transactionId String? @unique
  receiptUrl    String?

  // Status
  status        String  @default("pending") // "pending", "processing", "paid", "failed"
  failureReason String? @db.Text

  // Dates
  requestedAt DateTime  @default(now())
  processedAt DateTime?
  paidAt      DateTime?

  // Metadata
  referralIds String @db.Text // JSON array of referral IDs included

  @@index([affiliateId])
  @@index([status])
}

// ============================================
// INDUSTRY-SPECIFIC ASSESSMENTS
// ============================================

model Industry {
  id              String  @id @default(cuid())
  name            String  @unique
  slug            String  @unique
  icon            String // Emoji or icon name
  description     String  @db.Text
  regulatoryFocus String? @db.Text // e.g., "PCI-DSS, SOX" for Fintech
  isActive        Boolean @default(true)
  order           Int     @default(0)

  // Relations
  companies  Company[]
  categories IndustryCategory[]
  questions  IndustryQuestion[]
  benchmarks IndustryBenchmark[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([order])
}

model IndustryCategory {
  id         String             @id @default(cuid())
  industryId String
  industry   Industry           @relation(fields: [industryId], references: [id], onDelete: Cascade)
  categoryId String
  category   AssessmentCategory @relation(fields: [categoryId], references: [id])

  // Custom weight for this industry
  weight      Int // Percentage weight (0-100)
  description String? @db.Text // Industry-specific description

  questions IndustryQuestion[]

  @@unique([industryId, categoryId])
  @@index([industryId])
  @@index([categoryId])
}

model IndustryQuestion {
  id                 String           @id @default(cuid())
  industryId         String
  industry           Industry         @relation(fields: [industryId], references: [id], onDelete: Cascade)
  industryCategoryId String
  industryCategory   IndustryCategory @relation(fields: [industryCategoryId], references: [id], onDelete: Cascade)

  // Question details
  text        String  @db.Text
  description String? @db.Text
  type        String // "yes_no", "multiple_choice", "scale"
  options     String? @db.Text // JSON array for multiple choice
  weight      Int // Points for this question
  order       Int

  // Industry-specific metadata
  regulationReference String? // e.g., "PCI-DSS 3.2.1", "HIPAA 164.308"
  complianceLevel     String? // "required", "recommended", "optional"
  riskLevel           String? // "critical", "high", "medium", "low"

  // Guidance
  bestPractice        String? @db.Text
  implementationGuide String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([industryId])
  @@index([industryCategoryId])
  @@index([order])
}

model IndustryBenchmark {
  id         String   @id @default(cuid())
  industryId String
  industry   Industry @relation(fields: [industryId], references: [id], onDelete: Cascade)

  // Benchmark data
  metric     String // "average_score", "median_score", "top_quartile"
  categoryId String? // Optional: benchmark for specific category
  value      Float // The benchmark value
  sampleSize Int // Number of companies in sample

  // Time period
  year    Int
  quarter Int? // 1-4, optional

  updatedAt DateTime @updatedAt

  @@unique([industryId, metric, year, quarter, categoryId])
  @@index([industryId])
}

// ============================================
// SUBSCRIPTION & QUOTA SYSTEM
// ============================================

model UserPlan {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan           String   @default("free") // "free", "premium"
  scanQuota      Int      @default(4) // Free: 4, Premium: unlimited (-1)
  scansUsed      Int      @default(0)
  resetDate      DateTime // Monthly reset for free users
  subscriptionId String? // Stripe subscription ID
  status         String   @default("active") // "active", "cancelled", "expired"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@index([plan])
  @@index([status])
}

// ============================================
// TOOL EXECUTION TRACKING
// ============================================

model ToolExecution {
  id           String    @id @default(cuid())
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId   String?
  employee     Employee? @relation(fields: [employeeId], references: [id])
  toolName     String // "nikto", "nmap", "zenmap", "fofa"
  target       String
  parameters   String    @db.Text // JSON with tool-specific params
  command      String    @db.Text // Generated command
  status       String // "pending", "running", "completed", "failed"
  rawOutput    String?   @db.Text
  jsonResult   String?   @db.Text // Parsed JSON result
  aiAnalysis   String?   @db.Text // AI-generated analysis
  aiPrompt     String?   @db.Text // User's natural language request
  generatedBy  String    @default("manual") // "manual" or "ai"
  aiConfidence Int? // Score de confianza (0-100)
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  duration     Int? // seconds
  error        String?   @db.Text

  @@index([userId])
  @@index([employeeId])
  @@index([toolName])
  @@index([status])
  @@index([startedAt])
}

// ============================================
// DASHBOARD ACCESS CONTROL
// ============================================

model DashboardAccess {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dashboard String // "inicio", "ctf", "csirt", "financiero", "central", "empresa", "admin"
  hasAccess Boolean  @default(false)
  role      String? // Specific role within dashboard
  createdAt DateTime @default(now())

  @@unique([userId, dashboard])
  @@index([userId])
  @@index([dashboard])
}

// ============================================
// CTF CHALLENGES SYSTEM
// ============================================

model CTFChallenge {
  id          String     @id @default(cuid())
  title       String
  description String     @db.Text
  category    String // "web", "crypto", "forensics", "pwn", "reverse", "osint", "misc"
  difficulty  String // "easy", "medium", "hard", "expert"
  points      Int
  flag        String // Encrypted flag
  hints       String?    @db.Text // JSON array of hints
  files       String?    @db.Text // JSON array of file URLs
  dockerImage String? // Docker image for challenge environment
  isActive    Boolean    @default(true)
  programId   String?
  program     Program?   @relation(fields: [programId], references: [id])
  solves      CTFSolve[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([category])
  @@index([difficulty])
  @@index([isActive])
  @@index([programId])
}

model CTFSolve {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeId String
  challenge   CTFChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  solvedAt    DateTime     @default(now())
  timeToSolve Int? // seconds

  @@unique([userId, challengeId])
  @@index([userId])
  @@index([challengeId])
  @@index([solvedAt])
}

model CTFTeam {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?  @db.Text
  avatar      String?
  captainId   String // User ID of team captain
  members     String   @db.Text // JSON array of user IDs
  totalPoints Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([totalPoints])
  @@index([isActive])
}

// ============================================
