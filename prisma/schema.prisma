  updatedAt DateTime         @updatedAt

  @@index([moduleId])
  @@index([order])
}

model Resource {
  id        String   @id @default(cuid())
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
