{
    "name": "csirt-backend",
    "version": "1.0.0",
    "description": "CSIRT System Backend API",
    "main": "dist/server.js",
    "scripts": {
        "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "migrate": "prisma migrate dev",
        "generate": "prisma generate --schema=../prisma/schema.prisma && xcopy /E /I /Y ..\\node_modules\\@prisma\\client node_modules\\@prisma\\client && xcopy /E /I /Y ..\\node_modules\\.prisma node_modules\\.prisma"
    },
    "dependencies": {
        "@prisma/client": "^5.22.0",
        "express": "^4.18.2",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "jsonwebtoken": "^9.0.2",
        "bcryptjs": "^2.4.3",
        "socket.io": "^4.6.1",
        "bull": "^4.11.5",
        "ioredis": "^5.3.2",
        "zod": "^3.22.4",
        "winston": "^3.11.0",
        "helmet": "^7.1.0",
        "express-rate-limit": "^7.1.5",
        "compression": "^1.7.4"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/node": "^20.10.6",
        "@types/cors": "^2.8.17",
        "@types/jsonwebtoken": "^9.0.5",
        "@types/bcryptjs": "^2.4.6",
        "@types/compression": "^1.7.5",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.3.3",
        "prisma": "^5.22.0"
    }
}